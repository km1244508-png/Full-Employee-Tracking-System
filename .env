# Environment Configuration Template
# Copy this to .env and update values for your setup

# Database (optional - defaults to local SQLite)
# DATABASE_URL=sqlite:///attendance.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/attendance_db

# Company Name (shown in app header)
COMPANY_NAME=Your Company Name

# Cookie Security (IMPORTANT: Change in production!)
# Generate random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
COOKIE_PASSWORD=dev-only-change-this-secret

# Export Directory
EXPORT_DIR=exports

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
